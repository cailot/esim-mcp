#################################################################
#                    esim-mcp central config
# Local: copy to application.properties and fill in secrets.
#        application.properties is gitignored.
# CI:    GitHub Actions copies this file, then overrides secrets
#        via environment variables (see README / workflow).
#################################################################

#################################################################
# Report schedule (until Korea arrival)
#################################################################
report.end.date=2026-09-15
report.cron.hour=9
report.cron.minute=0
report.timezone=Asia/Seoul

#################################################################
# Search
#################################################################
search.query=한국 알뜰폰 eSIM 요금제 해외 SMS 수신 월 유지비 저렴 평생요금
search.extra.queries=프리티모바일 eSIM 든든한 200분6G 평생할인|알뜰폰 eSIM 특가 평생요금 웨이요 모요플랜|알뜰폰 eSIM 가입가능 최저 월요금 아이즈 리브엠 세븐모바일

#################################################################
# Report email
# Env override: REPORT_EMAIL_TO
#################################################################
report.email.to=
report.email.subject.prefix=[esim-mcp] Daily eSIM report

#################################################################
# Database Configuration (Supabase PostgreSQL)
# Env overrides:
#   SPRING_DATASOURCE_URL
#   SPRING_DATASOURCE_USERNAME
#   SPRING_DATASOURCE_PASSWORD
#################################################################
spring.datasource.url=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&TimeZone=Australia/Sydney
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQL10Dialect
spring.jpa.properties.hibernate.jdbc.time_zone=Australia/Sydney

#################################################################
# MCP (always live — real MCP servers are started on app boot)
#################################################################

# Brave Search
# Env override: BRAVE_API_KEY
mcp.brave.command=npx
mcp.brave.args=-y,@modelcontextprotocol/server-brave-search
mcp.brave.env.BRAVE_API_KEY=

# Playwright (page crawl / verify) — --headless avoids opening a visible Chrome window
mcp.playwright.command=npx
mcp.playwright.args=-y,@playwright/mcp@latest,--headless

# Sequential Thinking
mcp.sequential.command=npx
mcp.sequential.args=-y,@modelcontextprotocol/server-sequential-thinking

# Supabase MCP
# Env overrides: SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF
mcp.supabase.command=npx
mcp.supabase.args=-y,@supabase/mcp-server-supabase@latest,--project-ref=YOUR_PROJECT_REF
mcp.supabase.project.ref=
mcp.supabase.env.SUPABASE_ACCESS_TOKEN=

# Tool names (adjust to match installed MCP server versions)
mcp.tool.brave.search=brave_web_search
mcp.tool.playwright.navigate=browser_navigate
mcp.tool.playwright.snapshot=browser_snapshot
mcp.tool.sequential.thinking=sequentialthinking
mcp.tool.supabase.execute_sql=execute_sql

#################################################################
# Gmail SMTP (app password — treat as a password)
# Env override: SPRING_MAIL_USERNAME / SPRING_MAIL_PASSWORD
#################################################################
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
